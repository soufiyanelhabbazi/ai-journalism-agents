# Copy this file to .env and fill in your key(s)
# Required -- free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional -- fallback for judgment calls (desk + editor) only, used once
# Gemini's rate limit is exhausted for a given call. A separate free-tier
# account/quota pool, so it's additive capacity, not a workaround. The
# staff-writer stage deliberately never uses this, to keep every published
# article in one consistent voice. Leave as-is (or unset) to run Gemini-only.
# Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=your-key-here

# Required -- Turso (remote SQLite-compatible database). Local disk doesn't
# persist between requests on serverless hosts like Vercel, so persistence
# lives here instead of a local .db file. Free, no credit card:
# https://app.turso.tech/signup -- create a database, then copy its
# connection URL and generate an auth token from its dashboard page.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Required -- admin login. The whole app (dashboard + API) is gated behind
# this single login, since it curates and drafts content rather than
# serving a public audience directly. Pick your own username/password here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong

# Required -- signs the login session cookie so it can't be forged or
# tampered with. Generate a random one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value
