# Copy this file to .env and fill in your key(s)
#
# IMPORTANT when setting these in a hosting dashboard (e.g. Vercel ->
# Settings -> Environment Variables): paste each value with NO trailing
# newline or space. Whitespace is invisible there but makes an API key an
# illegal HTTP header value, which surfaces as a bare "Connection error."
# that looks nothing like a config problem. The app now strips these
# defensively, and "Run system check" in the dashboard flags any variable
# that still has stray whitespace stored.
# Required -- free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional -- fallback for judgment calls (desk + editor) only, used once
# Gemini's rate limit is exhausted for a given call. A separate free-tier
# account/quota pool, so it's additive capacity, not a workaround. The
# staff-writer stage deliberately never uses this, to keep every published
# article in one consistent voice. Leave as-is (or unset) to run Gemini-only.
# Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=your-key-here

# Optional -- override the model used for each provider. Both Google and
# Groq retire model names periodically and start returning 404
# "model_not_found", which takes that provider out silently; these let you
# switch without a code change. "Run system check" in the dashboard lists
# the models your Groq key can currently reach.
# GEMINI_MODEL=gemini-flash-lite-latest
# GROQ_MODEL=llama-3.1-8b-instant

# Required -- Turso (remote SQLite-compatible database). Local disk doesn't
# persist between requests on serverless hosts like Vercel, so persistence
# lives here instead of a local .db file. Free, no credit card:
# https://app.turso.tech/signup -- create a database, then copy its
# connection URL and generate an auth token from its dashboard page.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Required -- admin login. The whole app (dashboard + API) is gated behind
# this single login, since it curates and drafts content rather than
# serving a public audience directly. Pick your own username/password here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong

# Optional -- enables unattended, scheduled scout runs. Without it the
# dashboard's "Auto" switch still works (it runs while the page is open),
# but GET /api/cron/run rejects every scheduled call, so Vercel Cron and
# the GitHub Actions workflow in .github/workflows/scout.yml do nothing.
# Set the SAME value here (or in Vercel) and as a GitHub repository secret
# named CRON_SECRET. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The token unlocks only the run endpoint -- not the rest of the API.
CRON_SECRET=

# Required -- signs the login session cookie so it can't be forged or
# tampered with. Generate a random one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value
